+      if (!request.initiator.has_value() ||
+          !extensions::ExtensionsBrowserClient::Get()
+               ->IsWebUIAllowedToMakeNetworkRequests(*request.initiator)) {
+        LOG(ERROR) << "[Auren] HideRequest: WebUI initiator check failed for "
+                   << url << " — hiding request to avoid abort (CRASH-01)";
+        return true;
+      }
     }
 #endif  // DCHECK_IS_ON()
 
