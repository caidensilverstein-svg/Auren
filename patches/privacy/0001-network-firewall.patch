 namespace {
 
+// [Auren] Service firewall (defense in depth). Browser-process requests that
+// are not navigations (SimpleURLLoader users: component/extension updaters,
+// variations, safe browsing, stats pings, sync, search suggestions, ...) must
+// never reach Brave or Google *service* hosts. Renderer-originated requests
+// (the pages the user opens, the claude.ai side panel) are not affected, and
+// neither are navigations, so the user can still visit any site, including
+// google.com and brave.com. Escape hatch for debugging only:
+// --auren-allow-service-requests.
+constexpr auto kAurenBlockedServiceDomains = std::to_array<std::string_view>({
+    // Brave
+    "brave.com",
+    "bravesoftware.com",
+    "brave.software",
+    "basicattentiontoken.org",
+    // Google
+    "google.com",
+    "googleapis.com",
+    "gstatic.com",
+    "gvt1.com",
+    "gvt2.com",
+    "google-analytics.com",
+    "googletagmanager.com",
+    "doubleclick.net",
+    "googlesyndication.com",
+    "googleadservices.com",
+    // Placeholder domain that all compiled-out Brave endpoints now use.
+    "invalid",
+});
+
+bool IsAurenBlockedServiceHost(std::string_view host) {
+  for (std::string_view domain : kAurenBlockedServiceDomains) {
+    if (host == domain) {
+      return true;
+    }
+    if (host.size() > domain.size() && base::EndsWith(host, domain) &&
+        host[host.size() - domain.size() - 1] == '.') {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ShouldBlockAurenServiceRequest(const mojom::URLLoaderFactoryParams& params,
+                                    const ResourceRequest& request) {
+  if (!params.process_id.is_browser()) {
+    return false;
+  }
+  if (request.mode == mojom::RequestMode::kNavigate) {
+    return false;
+  }
+  if (!request.url.SchemeIsHTTPOrHTTPS() && !request.url.SchemeIsWSOrWSS()) {
+    return false;
+  }
+  static const bool allow = base::CommandLine::ForCurrentProcess()->HasSwitch(
+      "auren-allow-service-requests");
+  if (allow) {
+    return false;
+  }
+  return IsAurenBlockedServiceHost(request.url.host());
+}
