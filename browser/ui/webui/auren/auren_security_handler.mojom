module auren.mojom;

struct SecurityState {
  bool js_enabled;
  bool https_enforced;
  bool cookies_isolated;
  int32 fingerprint_score;
  bool tor_active;
  string tor_exit_country;
  bool dns_active;
};

interface AurenSecurityHandler {
  GetSecurityState() => (SecurityState state);
  SetJavaScriptEnabled(bool enabled);
  SetHttpsOnlyMode(bool enabled);
};
